{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "syllabus:validate": "tsx ./src/syllabus/cli.ts --mode=validate",
    "syllabus:import": "tsx ./src/syllabus/cli.ts --mode=import",
    "syllabus:adopt": "tsx ./src/syllabus/cli.ts --mode=adopt",
    "syllabus:publish": "tsx ./src/syllabus/cli.ts --mode=publish",
    "syllabus:applicability": "tsx ./src/syllabus/applicability-cli.ts",
    "syllabus:cleanup-placeholders": "tsx ./src/syllabus/cleanup-placeholder-syllabus.ts",
    "route-manifest:validate": "tsx ./src/route-manifest/cli.ts --mode=validate",
    "route-manifest:hash": "tsx ./src/route-manifest/cli.ts --mode=hash",
    "route-manifest:canonicalize": "tsx ./src/route-manifest/cli.ts --mode=canonicalize",
    "route-manifest:publish": "tsx ./src/route-manifest/cli.ts --mode=publish",
    "test": "vitest run",
    "test:unit": "vitest run src/syllabus/__tests__/parse-csv.test.ts src/syllabus/__tests__/normalize.test.ts src/syllabus/__tests__/cli.test.ts src/syllabus/__tests__/cli-publish.test.ts src/syllabus/__tests__/content-hash.test.ts src/syllabus/__tests__/applicability-manifest.test.ts",
    "test:route-manifest": "vitest run src/route-manifest/__tests__/weighting.test.ts src/route-manifest/__tests__/validate.test.ts src/route-manifest/__tests__/hash.test.ts src/route-manifest/__tests__/resolve.test.ts src/route-manifest/__tests__/year-mapping.test.ts src/route-manifest/__tests__/cli.test.ts src/route-manifest/__tests__/consistency.test.ts src/route-manifest/__tests__/catalog-loader.test.ts src/route-manifest/__tests__/publish-safety.test.ts",
    "test:db": "vitest run src/syllabus/__tests__/db-upsert.test.ts src/syllabus/__tests__/db-model-d.test.ts",
    "db-harness": "tsx ./src/db-harness/index.ts",
    "test:http-integration": "tsx ./src/db-harness/run-http-integration-cli.ts",
    "check:migrations": "tsx ./src/db-harness/check-migration-integrity.ts",
    "test:harness": "vitest run src/db-harness/__tests__/target-safety.test.ts src/db-harness/__tests__/migration-integrity.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@workspace/db": "workspace:*",
    "csv-parse": "^5.6.0",
    "drizzle-orm": "catalog:",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
