# Copy to `.env.local` (gitignored) and fill in real values.
# Never commit passwords, access tokens, or service-role keys.

# ---------------------------------------------------------------------------
# Postgres (Drizzle + Express API + syllabus scripts)
# ---------------------------------------------------------------------------
# App / pooler connection (Session or Transaction pooler is fine for the API).
DATABASE_URL=

# Direct (or Session-pooler) URL preferred for `pnpm --filter @workspace/db migrate`.
# Transaction-mode pooler (:6543) is a poor fit for DDL. Optional until you split URLs;
# if unset, migrations use DATABASE_URL.
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase (frontend — Vite). Required once Phase 2 wires real Auth.
# Use the publishable (anon) key only — never a service-role key in VITE_*.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase (API server). Same project URL/publishable key for JWT verification
# helpers when Auth lands. Not required for local syllabus import today.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server-only (future). Do NOT put this in the frontend or any VITE_* var.
# Only add to a trusted server env when middleware/admin jobs need it.
# SUPABASE_SERVICE_ROLE_KEY=
# ---------------------------------------------------------------------------

# Local API / Vite (scripts/dev.sh defaults: API 3001, web 5173)
# PORT=
# API_PORT=
# WEB_PORT=
