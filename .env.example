# Copy to `.env.local` (gitignored) and fill in real values.
# Never commit passwords, access tokens, or service-role keys.

# ---------------------------------------------------------------------------
# Postgres (Drizzle + Express API + syllabus scripts)
# ---------------------------------------------------------------------------
# Application runtime database connection (P5-CUTOVER-01).
# In serverless/production runtimes, this MUST use the Supabase Transaction pooler (:6543).
DATABASE_URL=

# Hosted migration / DDL / administrative connection for
# `pnpm --filter @workspace/db migrate` and schema push.
# Use a direct connection where supported, or a supported Session pooler (:5432)
# connection appropriate for migration tooling. Do not prefer Transaction pooling.
# If unset, migrations retain a compatibility fallback to DATABASE_URL. That fallback
# is suitable only when DATABASE_URL itself is valid for migrations, such as an
# appropriate local or single-connection setup; the hosted serverless Transaction
# pooler DATABASE_URL is not the recommended migration connection.
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase (frontend — Vite). Required once Phase 2 wires real Auth.
# Use the publishable (anon) key only — never a service-role key in VITE_*.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Show Google sign-in only when the hosted provider is configured.
VITE_GOOGLE_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# Supabase (API server). Same project URL/publishable key for JWT verification
# helpers when Auth lands. Not required for local syllabus import today.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server-only (future). Do NOT put this in the frontend or any VITE_* var.
# Only add to a trusted server env when middleware/admin jobs need it.
# SUPABASE_SERVICE_ROLE_KEY=
# ---------------------------------------------------------------------------

# Local API / Vite (scripts/dev.sh defaults: API 3001, web 5173)
# PORT=
# API_PORT=
# WEB_PORT=
